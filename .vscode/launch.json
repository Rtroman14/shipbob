{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Pipeline",
            "program": "${workspaceFolder}/test/pipeline.test.js",
            "envFile": "${workspaceFolder}/.env.local",
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Run npm start",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "start"],
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal"
        }
    ]
}
